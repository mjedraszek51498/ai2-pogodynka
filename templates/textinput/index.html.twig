{% extends 'base.html.twig' %}

{% block title %} Test TextinputController!{% endblock %}

{% block body %}
    <h1> Text submission form</h1>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Submit</button>
    {{ form_end(form) }}

    {% if submittedText is not empty %}
        <h2> You submitted: </h2>
        <p> {{ submittedText }} </p>
        <p>{{ submittedText|raw }}</p>
    {% endif %}

{% endblock %}
